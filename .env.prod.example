# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # fill in the secrets below, then:
#   docker compose -f docker-compose.staging.yml -f docker-compose.prod.yml \
#       --env-file .env.prod up -d --build
#
# Generate strong secrets with:  openssl rand -hex 32
# NEVER commit the filled-in .env.prod (it is git-ignored).

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=skava
POSTGRES_USER=skava
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password   # openssl rand -hex 24

# ── Public URL (MUST be https in production — the app enforces it) ──────────
SKAVA_PUBLIC_BASE_URL=https://skava.example.org

# ── Secrets ─────────────────────────────────────────────────────────────────
INTERNAL_API_KEY=CHANGE_ME_internal_api_key        # openssl rand -hex 32
ADMIN_SESSION_SECRET=CHANGE_ME_admin_session_secret # openssl rand -hex 32

# ── Optional ────────────────────────────────────────────────────────────────
# Comma-separated bearer tokens to require on discovery/access endpoints.
SKAVA_ACCESS_TOKENS=
# Only if you use SODA execute delegation to a co-located VisIVO backend.
SKAVA_VISIVO_BACKEND_TOKEN=
SKAVA_SODA_BACKEND_TIMEOUT_SECONDS=120

SKAVA_LOG_LEVEL=INFO
