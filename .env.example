SKAVA_APP_NAME=SKAVA Data Discovery Service
SKAVA_ENV=dev

# Required for staging/production
SKAVA_DATABASE_URL=postgresql+psycopg://skava:skava@db:5432/skava
SKAVA_PUBLIC_BASE_URL=http://localhost:8000

SKAVA_LOG_LEVEL=INFO

SKAVA_DB_POOL_SIZE=10
SKAVA_DB_MAX_OVERFLOW=20
SKAVA_DB_POOL_TIMEOUT=30
SKAVA_DB_POOL_RECYCLE=1800
SKAVA_DB_CONNECT_RETRIES=10
SKAVA_DB_CONNECT_RETRY_DELAY=1.5

INTERNAL_API_KEY=change-me-internal
SKAVA_ACCESS_TOKENS=
SKAVA_FEDERATED_SRC_URLS=
SKAVA_FEDERATION_TIMEOUT_SECONDS=2.0

# ── SODA execution (compute-next-to-data) ────────────────────────────────────
# /soda/execute delegates the byte-level FITS cutout to a node's co-located
# VisIVO backend (Node.visivo_backend_url) when the replica is a file:// URL.
# Bearer token forwarded as X-Visivo-Token when the node backend requires auth.
SKAVA_VISIVO_BACKEND_TOKEN=
SKAVA_SODA_BACKEND_TIMEOUT_SECONDS=120.0
